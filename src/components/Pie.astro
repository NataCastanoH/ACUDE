---
import Simbolo from './Simbolo.astro';
import { sitio } from '../lib/datos.js';
---
<footer class="pie">
  <div class="contenedor pie__fila">
    <div class="pie__marca">
      <p class="pie__nombre"><Simbolo tamano={28} /> {sitio.nombre}</p>
      <p class="etiqueta pie__linea">{sitio.pie.linea}</p>
    </div>
    <p class="texto-2">{sitio.pie.derecha}</p>
  </div>
</footer>

<style>
  .pie { border-top: 1px solid var(--linea); padding-block: 40px; }
  .pie__fila { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; }
  .pie__marca { display: flex; flex-direction: column; gap: 10px; }
  .pie__nombre { display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 18px; }
  .pie__linea { font-size: 12px; color: var(--texto-2); }
  .texto-2 { font-size: 15px; }
</style>
